/* 文章详情页 */
.page {
  background: #fff;
  min-height: 100vh;
}

/* ── 头部 ── */
.article-header {
  padding: 0 0 20rpx;
}

.article-cover {
  width: 100%;
  height: 420rpx;
  display: block;
  background: #f0f0f0;
}

.article-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 32rpx 0;
  margin-bottom: 12rpx;
}

.article-badge {
  display: inline-block;
  background: #E8F5E9;
  color: #07C160;
  font-size: 24rpx;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.article-date {
  font-size: 24rpx;
  color: #bbb;
}

.article-title {
  display: block;
  padding: 0 32rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #1a1a1a;
  line-height: 1.4;
}

/* ── 正文 ── */
.article-body {
  padding: 20rpx 32rpx 0;
  font-size: 30rpx;
  line-height: 1.8;
  color: #333;
  word-break: break-word;
}

/* rich-text 内样式需用内联 style 或子选择器 */
.article-body rich-text {
  display: block;
}

.article-body rich-text h1 {
  font-size: 36rpx;
  font-weight: 700;
  margin: 40rpx 0 20rpx;
  color: #1a1a1a;
}

.article-body rich-text h2 {
  font-size: 34rpx;
  font-weight: 700;
  margin: 36rpx 0 16rpx;
  color: #1a1a1a;
  padding-left: 16rpx;
  border-left: 6rpx solid #07C160;
}

.article-body rich-text h3 {
  font-size: 32rpx;
  font-weight: 600;
  margin: 28rpx 0 14rpx;
  color: #333;
}

.article-body rich-text p {
  margin: 16rpx 0;
  font-size: 30rpx;
  line-height: 1.85;
  color: #333;
}

.article-body rich-text strong {
  font-weight: 700;
  color: #D32F2F;
}

.article-body rich-text hr {
  margin: 40rpx 0;
  border: none;
  border-top: 2rpx solid #f0f0f0;
}

.article-body rich-text blockquote {
  margin: 20rpx 0;
  padding: 16rpx 24rpx;
  background: #f8f8f8;
  border-left: 6rpx solid #07C160;
  color: #555;
  font-style: italic;
}

/* ── 金句 ── */
.article-golden-box {
  margin: 40rpx 32rpx;
  background: #FFF8E1;
  border-radius: 16rpx;
  padding: 28rpx;
}

.golden-box-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #8D6E00;
  margin-bottom: 20rpx;
}

.golden-line {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.golden-line:last-child {
  margin-bottom: 0;
}

.golden-quote {
  font-size: 36rpx;
  color: #F9A825;
  line-height: 1;
}

.golden-body {
  font-size: 28rpx;
  color: #6D4C00;
  line-height: 1.6;
  padding: 0 8rpx;
  font-weight: 500;
}

/* ── 标签 ── */
.article-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding: 0 32rpx 30rpx;
}

.article-tags .tag {
  font-size: 22rpx;
  color: #999;
  background: #f5f5f5;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

/* ── 底部 ── */
.article-footer {
  padding: 40rpx 32rpx 60rpx;
  text-align: center;
}

.footer-divider {
  width: 80rpx;
  height: 4rpx;
  background: #ddd;
  margin: 0 auto 30rpx;
  border-radius: 2rpx;
}

.footer-big-text {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
}

.footer-small-text {
  display: block;
  font-size: 24rpx;
  color: #bbb;
  margin-bottom: 30rpx;
}

.footer-actions {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 30rpx;
}

.share-btn, .rewards-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: #f5f5f5;
  border: none;
  border-radius: 40rpx;
  padding: 16rpx 36rpx;
  font-size: 26rpx;
  color: #333;
  line-height: 1;
}

.share-btn::after, .rewards-btn::after {
  border: none;
}

.share-btn {
  background: #E8F5E9;
  color: #07C160;
}

.rewards-btn {
  background: #FFF3E0;
  color: #E65100;
}

.footer-thanks {
  font-size: 24rpx;
  color: #ccc;
}
